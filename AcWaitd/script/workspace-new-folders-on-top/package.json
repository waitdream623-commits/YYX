{
    "name": "workspace-new-folders-on-top",
    "displayName": "Workspace New Folders on Top",
    "description": "Places newly added roots first in workspaces that enable this setting.",
    "version": "1.0.0",
    "publisher": "acwaitd-local",
    "engines": { "vscode": "^1.74.0" },
    "activationEvents": ["onStartupFinished"],
    "main": "./extension.js",
    "contributes": {
        "configuration": {
            "title": "Workspace New Folders on Top",
            "properties": {
                "workspaceNewFoldersOnTop.enabled": {
                    "type": "boolean",
                    "default": false,
                    "scope": "window",
                    "description": "Place newly added root folders at the top. Enable this in the workspace settings."
                }
            }
        }
    }
}
